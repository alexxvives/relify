# INT/Staging Environment Variables
# Copy to .env.int for local INT testing

# INT Database (separate from production)
# Use a separate Neon branch or local Postgres for INT
INT_DATABASE_URL=postgresql://releva_int:password@localhost:5432/releva_int

# Auth (separate secrets from production)
INT_BETTER_AUTH_SECRET=int-replace-with-a-long-random-string-different-from-production
INT_BETTER_AUTH_URL=https://releva-int.your-account.workers.dev

# Email disabled by default
EMAIL_DISABLED=true

# Stripe TEST only (optional). Unset = payments stay disabled. Never sk_live_/pk_live_/rk_live_.
INT_STRIPE_SECRET_KEY=
INT_STRIPE_WEBHOOK_SECRET=
INT_STRIPE_PUBLISHABLE_KEY=

# Leave unset on INT so GA4 never loads.
GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional external APIs (can be empty for INT)
CONTEXT7_API_KEY=
EINFORMA_API_USER=
EINFORMA_API_KEY=
APIEMPRESAS_API_KEY=
