generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

generator client_cloudflare {
  provider = "prisma-client"
  output   = "../src/generated/prisma-worker"
  runtime  = "cloudflare"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  seller
  investor
  advisor
  admin

  @@map("user_role")
}

enum WaitlistRole {
  company
  investor
  advisor

  @@map("waitlist_role")
}

enum ProjectStatus {
  draft
  pending
  published

  @@map("project_status")
}

enum BuyerPlan {
  none
  limited
  unlimited

  @@map("buyer_plan")
}

enum HeadcountRange {
  band_1_5
  band_6_10
  band_11_20
  band_21_50
  band_over_50

  @@map("headcount_range")
}

enum CnaeRole {
  principal
  secondary

  @@map("cnae_role")
}

enum ActivitySliceKind {
  capital
  product
  client

  @@map("activity_slice_kind")
}

enum CustomerBase {
  business
  consumer
  mixed

  @@map("customer_base")
}

enum FinancialYearKind {
  closed
  forecast

  @@map("financial_year_kind")
}

enum MessageKind {
  question
  meeting
  offer

  @@map("message_kind")
}

enum MessageAuthor {
  seller
  investor

  @@map("message_author")
}

model User {
  id                   String                  @id
  name                 String
  email                String
  emailVerified        Boolean                 @default(false) @map("email_verified")
  image                String?
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  role                 UserRole?               @map("role")
  referralSource       String?                 @map("referral_source")
  onboardedAt          DateTime?               @map("onboarded_at")
  termsAcceptedAt      DateTime?               @map("terms_accepted_at")
  signaturePng         Bytes?                  @map("signature_png")
  suspendedAt          DateTime?               @map("suspended_at")
  lastName             String?                 @map("last_name")
  phone                String?
  nationalId           String?                 @map("national_id")
  pendingCif           String?                 @map("pending_cif")
  advisorProfile       AdvisorProfile?
  sessions             Session[]
  accounts             Account[]
  projects             Project[]
  projectAccesses      ProjectAccess[]
  favorites            ProjectFavorite[]
  projectViews         ProjectView[]
  hiddenProjects       ProjectHidden[]
  notifications        Notification[]
  advisoryQuotes       AdvisoryQuote[]
  registryPrefill      CompanyRegistryPrefill?
  dataRoomGrants       DataRoomGrant[]
  dataRoomFileShares   DataRoomFileShare[]
  projectMessages      ProjectMessage[]
  saleMandates         SaleMandate[]
  billingCustomer      BillingCustomer?
  listingPayments      ListingPayment[]
  engagementsRequested AdvisoryEngagement[]    @relation("EngagementRequester")
  engagementsOwned     AdvisoryEngagement[]    @relation("EngagementAdvisor")
  investorProfile      InvestorProfile?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

model Project {
  id                  String               @id
  slug                String               @unique
  codename            String
  region              String
  revenueCents        BigInt                  @map("revenue_cents")
  ebitdaCents         BigInt                  @map("ebitda_cents")
  adjustedEbitdaCents BigInt                  @map("adjusted_ebitda_cents")
  /// t82: seller adjustments [{type, amountCents, reason}]; null = legacy declared figure without detail.
  ebitdaAdjustments   Json?                @map("ebitda_adjustments")
  askingPriceCents    BigInt                  @map("asking_price_cents")
  /// t90: seller financing: "yes" | "no"; null = not answered. Leftover "negotiable" is read as yes until the INT data migration. Terms only for yes.
  sellerFinancing        String? @map("seller_financing")
  sellerFinancingMaxPct  Int?    @map("seller_financing_max_pct")
  sellerFinancingYears   Int?    @map("seller_financing_years")
  /// t93: would the seller stay on as an adviser: "no" | "1w" | "1m" | "3m" | "6m" | "1y" | "2y"; null = not answered.
  sellerStay             String? @map("seller_stay")
  /// t96: optional business profile (Cómo es tu negocio) and asking-price basis.
  ownerDependence        String? @map("owner_dependence")
  premisesKind           String? @map("premises_kind")
  rentMonthlyCents       BigInt? @map("rent_monthly_cents")
  leaseYearsRemaining    Int?    @map("lease_years_remaining")
  recurringRevenuePct    Int?    @map("recurring_revenue_pct")
  /// "debt_free_cash_free" | "shares"; null = use defaultAskingPriceIncludes.
  askingPriceIncludes    String? @map("asking_price_includes")
  verifiedAt          DateTime?            @map("verified_at")
  netIncomeCents      BigInt                  @map("net_income_cents")
  legalName           String               @map("legal_name")
  cif                 String
  address             String
  foundedYear         Int?                 @map("founded_year")
  description         String?              @db.Text
  saleReason          String?              @map("sale_reason")
  opexCents           BigInt?                 @map("opex_cents")
  headcountRange      HeadcountRange?      @map("headcount_range")
  customerBase        CustomerBase?        @map("customer_base")
  status              ProjectStatus        @default(published) @map("status")
  ownerId             String?              @map("owner_id")
  owner               User?                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now()) @map("created_at")
  shareholders        Shareholder[]
  dataRoomFiles       DataRoomFile[]
  dataRoomFolders     DataRoomFolder[]
  cnaes               ProjectCnae[]
  activitySlices      ActivitySlice[]
  years               ProjectYear[]
  accesses            ProjectAccess[]
  favorites           ProjectFavorite[]
  views               ProjectView[]
  hiddenBy            ProjectHidden[]
  dataRoomGrants      DataRoomGrant[]
  messages            ProjectMessage[]
  saleMandates        SaleMandate[]
  listingPayment      ListingPayment?
  successFee          SuccessFee?
  engagements         AdvisoryEngagement[]
  financialFilings    FinancialFiling[]
  averageHeadcount    Float?               @map("average_headcount")
  sabiRequestedAt     DateTime?            @map("sabi_requested_at")
  sabiImportedAt      DateTime?            @map("sabi_imported_at")
  /// t73b: when an admin sent the "informe financiero listo" email to the seller, and who.
  reportNotifiedAt    DateTime?            @map("report_notified_at")
  reportNotifiedById  String?              @map("report_notified_by_id")
  sabiFileName        String?              @map("sabi_file_name")
  sabiData            Json?                @map("sabi_data")
  legalForm           String?              @map("legal_form")
  accountsFormat      String?              @map("accounts_format")
  audited             Boolean?
  formerName                         String?   @map("former_name")
  legalFormDetail                    String?   @map("legal_form_detail")
  companyType                        String?   @map("company_type")
  shareCapitalCents                  BigInt?   @map("share_capital_cents")
  incorporatedOn                     String?   @map("incorporated_on")
  companyStatus                      String?   @map("company_status")
  companyStatusDetail                String?   @map("company_status_detail")
  accountsType                       String?   @map("accounts_type")
  lastAccountsOn                     String?   @map("last_accounts_on")
  yearsAvailable                     Int?      @map("years_available")
  auditorName                        String?   @map("auditor_name")
  street                             String?   @map("street")
  postalCode                         String?   @map("postal_code")
  city                               String?   @map("city")
  province                           String?   @map("province")
  country                            String?   @map("country")
  phone                              String?   @map("phone")
  website                            String?   @map("website")
  president                          String?   @map("president")
  executiveDirector                  String?   @map("executive_director")
  globalUltimateOwner                String?   @map("global_ultimate_owner")
  independenceIndicator              String?   @map("independence_indicator")
  groupCompanyCount                  Int?      @map("group_company_count")
  shareholderCount                   Int?      @map("shareholder_count")
  subsidiaryCount                    Int?      @map("subsidiary_count")
  activityDescription                String?   @map("activity_description")
  activityCodes                      Json?     @map("activity_codes")
  directors                          Json?     @map("directors")
  shareholdings                      Json?     @map("shareholdings")
  subsidiaries                       Json?     @map("subsidiaries")
  banks                              Json?     @map("banks")
  audits                             Json?     @map("audits")
  sabiExtra                          Json?     @map("sabi_extra")

  photos              ProjectPhoto[]
  adjustmentDocuments AdjustmentDocument[]
  @@index([ownerId])
  @@map("project")
}

model ProjectCnae {
  id        String   @id
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code      String
  role      CnaeRole
  position  Int

  @@unique([projectId, code])
  @@index([projectId])
  @@map("project_cnae")
}

model ActivitySlice {
  id          String            @id
  projectId   String            @map("project_id")
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        ActivitySliceKind
  position    Int
  basisPoints Int               @map("basis_points")

  @@unique([projectId, kind, position])
  @@index([projectId])
  @@map("activity_slice")
}

model ProjectYear {
  id                         String            @id
  projectId                  String            @map("project_id")
  project                    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  year                       Int
  kind                       FinancialYearKind
  salesCents                 BigInt?              @map("sales_cents")
  inventoryChangeCents       BigInt?              @map("inventory_change_cents")
  ownUseCents                BigInt?              @map("own_use_cents")
  suppliesCents              BigInt?              @map("supplies_cents")
  otherOperatingIncomeCents  BigInt?              @map("other_operating_income_cents")
  staffCostsCents            BigInt?              @map("staff_costs_cents")
  otherOperatingCostsCents   BigInt?              @map("other_operating_costs_cents")
  grantIncomeCents           BigInt?              @map("grant_income_cents")
  provisionSurplusCents      BigInt?              @map("provision_surplus_cents")
  assetImpairmentCents       BigInt?              @map("asset_impairment_cents")
  subsidiaryControlLossCents BigInt?              @map("subsidiary_control_loss_cents")
  negativeDifferenceCents    BigInt?              @map("negative_difference_cents")
  otherResultsCents          BigInt?              @map("other_results_cents")
  amortizationCents          BigInt?              @map("amortization_cents")
  currentAssetsCents         BigInt?              @map("current_assets_cents")
  cashCents                  BigInt?              @map("cash_cents")
  nonCurrentAssetsCents      BigInt?              @map("non_current_assets_cents")
  currentLiabilitiesCents    BigInt?              @map("current_liabilities_cents")
  longTermDebtCents          BigInt?              @map("long_term_debt_cents")
  nonCurrentLiabilitiesCents BigInt?              @map("non_current_liabilities_cents")
  shortTermDebtCents         BigInt?              @map("short_term_debt_cents")
  equityCents                BigInt?              @map("equity_cents")
  financialResultCents       BigInt?              @map("financial_result_cents")
  profitBeforeTaxCents       BigInt?              @map("profit_before_tax_cents")
  netResultCents             BigInt?              @map("net_result_cents")
  inventoryCents             BigInt?              @map("inventory_cents")
  receivablesCents           BigInt?              @map("receivables_cents")
  suppliersCents             BigInt?              @map("suppliers_cents")
  cashFlowCents              BigInt?              @map("cash_flow_cents")
  addedValueCents            BigInt?              @map("added_value_cents")
  employees                  Int?
  ratios                     Json?
  dataSource                 String?           @map("data_source")
  confirmedAt                DateTime?         @map("confirmed_at")
  intangibleAssetsCents              BigInt?   @map("intangible_assets_cents")
  tangibleAssetsCents                BigInt?   @map("tangible_assets_cents")
  otherFixedAssetsCents              BigInt?   @map("other_fixed_assets_cents")
  otherCurrentAssetsCents            BigInt?   @map("other_current_assets_cents")
  totalAssetsCents                   BigInt?   @map("total_assets_cents")
  subscribedCapitalCents             BigInt?   @map("subscribed_capital_cents")
  otherEquityCents                   BigInt?   @map("other_equity_cents")
  provisionsCents                    BigInt?   @map("provisions_cents")
  otherNonCurrentLiabilitiesCents    BigInt?   @map("other_non_current_liabilities_cents")
  otherCurrentLiabilitiesCents       BigInt?   @map("other_current_liabilities_cents")
  totalLiabilitiesAndEquityCents     BigInt?   @map("total_liabilities_and_equity_cents")
  workingCapitalCents                BigInt?   @map("working_capital_cents")
  operatingRevenueCents              BigInt?   @map("operating_revenue_cents")
  materialsConsumptionCents          BigInt?   @map("materials_consumption_cents")
  materialsCents                     BigInt?   @map("materials_cents")
  grossResultCents                   BigInt?   @map("gross_result_cents")
  sabiOtherOperatingExpensesCents    BigInt?   @map("sabi_other_operating_expenses_cents")
  otherOperatingItemsCents           BigInt?   @map("other_operating_items_cents")
  operatingResultCents               BigInt?   @map("operating_result_cents")
  ebitCents                          BigInt?   @map("ebit_cents")
  ebitdaCents                        BigInt?   @map("ebitda_cents")
  financialIncomeCents               BigInt?   @map("financial_income_cents")
  financialExpensesCents             BigInt?   @map("financial_expenses_cents")
  interestExpensesCents              BigInt?   @map("interest_expenses_cents")
  corporateTaxCents                  BigInt?   @map("corporate_tax_cents")
  ordinaryResultCents                BigInt?   @map("ordinary_result_cents")
  extraordinaryIncomeCents           BigInt?   @map("extraordinary_income_cents")
  extraordinaryExpensesCents         BigInt?   @map("extraordinary_expenses_cents")
  extraordinaryResultCents           BigInt?   @map("extraordinary_result_cents")
  closingOn                          String?   @map("closing_on")
  months                             Int?      @map("months")
  accountingBasis                    String?   @map("accounting_basis")

  @@unique([projectId, year])
  @@index([projectId])
  @@map("project_year")
}

model ProjectAccess {
  id                String         @id
  projectId         String         @map("project_id")
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investorId        String         @map("investor_id")
  investor          User           @relation(fields: [investorId], references: [id], onDelete: Cascade)
  requestedAt       DateTime       @default(now()) @map("requested_at")
  sellerAcceptedAt  DateTime?      @map("seller_accepted_at")
  ndaAcceptedAt     DateTime?      @map("nda_accepted_at")
  loiAcceptedAt     DateTime?      @map("loi_accepted_at")
  buyerPlanAtMatch  BuyerPlan?     @map("buyer_plan_at_match")
  diligencePassedAt DateTime?      @map("diligence_passed_at")
  cancelledAt       DateTime?      @map("cancelled_at")
  cancelledBy       String?        @map("cancelled_by")
  ndaSignature      Bytes?         @map("nda_signature")
  /// t93: exact NDA text the buyer signed; the PDF is rendered from it.
  ndaText           String?        @map("nda_text")
  loiSignature      Bytes?         @map("loi_signature")
  loiSignedAt       DateTime?      @map("loi_signed_at")
  /// When each side last opened the chat; drives the real unread badge.
  sellerReadAt      DateTime?      @map("seller_read_at")
  investorReadAt    DateTime?      @map("investor_read_at")
  saleContracts     SaleContract[]

  @@unique([projectId, investorId])
  @@index([investorId])
  @@map("project_access")
}

model ProjectFavorite {
  id         String   @id
  projectId  String   @map("project_id")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investorId String   @map("investor_id")
  investor   User     @relation(fields: [investorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([projectId, investorId])
  @@index([investorId])
  @@map("project_favorite")
}

/// One row per investor who opened a company's ficha; feeds the seller's "visitas a la ficha".
model ProjectView {
  id           String   @id
  projectId    String   @map("project_id")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investorId   String   @map("investor_id")
  investor     User     @relation(fields: [investorId], references: [id], onDelete: Cascade)
  viewedAt     DateTime @default(now()) @map("viewed_at")
  lastViewedAt DateTime @default(now()) @map("last_viewed_at")

  @@unique([projectId, investorId])
  @@index([investorId])
  @@map("project_view")
}

/// A company an investor chose to hide from their Mercado grid. Same shape as favourites, kept per account.
model ProjectHidden {
  id         String   @id
  projectId  String   @map("project_id")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investorId String   @map("investor_id")
  investor   User     @relation(fields: [investorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([projectId, investorId])
  @@index([investorId])
  @@map("project_hidden")
}

model Notification {
  id        String    @id
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notification")
}

model AdvisoryQuote {
  id         String   @id
  investorId String   @map("investor_id")
  investor   User     @relation(fields: [investorId], references: [id], onDelete: Cascade)
  services   String[]
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([investorId])
  @@map("advisory_quote")
}

model CompanyRegistryPrefill {
  userId              String          @id @map("user_id")
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cif                 String
  legalName           String          @map("legal_name")
  address             String
  region              String
  codename            String
  foundedYear         Int?            @map("founded_year")
  description         String?         @db.Text
  principalCnae       String?         @map("principal_cnae")
  secondaryCnaes      String[]        @default([]) @map("secondary_cnaes")
  revenueCents        Int?            @map("revenue_cents")
  ebitdaCents         Int?            @map("ebitda_cents")
  adjustedEbitdaCents Int?            @map("adjusted_ebitda_cents")
  headcountRange      HeadcountRange? @map("headcount_range")
  statementYear       Int?            @map("statement_year")

  @@map("company_registry_prefill")
}

// Per-CIF cache of registry lookups (APIEmpresas, OpenMercantil) so a quota
// credit is spent once per company, not once per seller click.
model CompanyRegistryCache {
  cif       String
  source    String
  found     Boolean
  record    Json?
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@id([cif, source])
  @@map("company_registry_cache")
}

model AdvisorProfile {
  userId           String    @id @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName     String    @default("") @map("business_name")
  nif              String    @default("")
  postalCode       String    @default("") @map("postal_code")
  description      String    @default("") @db.Text
  verifiedAt       DateTime? @map("verified_at")
  sectors          String[]  @default([])
  services         Json      @default("[]")
  closedOperations Json      @default("[]") @map("closed_operations")
  dealsAnswered    Boolean   @default(false) @map("deals_answered")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("advisor_profile")
}

model InvestorProfile {
  userId       String   @id @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoPath    String   @default("") @map("photo_path")
  city         String   @default("")
  province     String   @default("")
  investorType String   @default("") @map("investor_type")
  ticket       String   @default("")
  sectors      String   @default("")
  thesis       String   @default("") @db.Text
  contribution String   @default("") @db.Text
  stake        String   @default("")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("investor_profile")
}

model Shareholder {
  id        String  @id
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String

  @@index([projectId])
  @@map("shareholder")
}

model DataRoomFile {
  id            String              @id
  projectId     String              @map("project_id")
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName      String              @map("file_name")
  folder        String              @default("Otros")
  createdAt     DateTime            @default(now()) @map("created_at")
  shares        DataRoomFileShare[]
  advisorShares AdvisorFileShare[]

  @@index([projectId])
  @@map("data_room_file")
}

model DataRoomFileShare {
  id         String       @id
  fileId     String       @map("file_id")
  file       DataRoomFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  investorId String       @map("investor_id")
  investor   User         @relation(fields: [investorId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now()) @map("created_at")

  @@unique([fileId, investorId])
  @@index([investorId])
  @@map("data_room_file_share")
}

model DataRoomFolder {
  id        String   @id
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([projectId, name])
  @@index([projectId])
  @@map("data_room_folder")
}

model DataRoomGrant {
  id         String   @id
  projectId  String   @map("project_id")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investorId String   @map("investor_id")
  investor   User     @relation(fields: [investorId], references: [id], onDelete: Cascade)
  grantedAt  DateTime @default(now()) @map("granted_at")

  @@unique([projectId, investorId])
  @@index([investorId])
  @@map("data_room_grant")
}

model ProjectMessage {
  id         String        @id
  projectId  String        @map("project_id")
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investorId String        @map("investor_id")
  investor   User          @relation(fields: [investorId], references: [id], onDelete: Cascade)
  author     MessageAuthor
  kind       MessageKind
  body       String        @db.Text
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([investorId, kind])
  @@index([projectId, investorId, createdAt])
  @@map("project_message")
}

model SaleMandate {
  id        String   @id
  advisorId String   @map("advisor_id")
  advisor   User     @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([advisorId, projectId])
  @@index([projectId])
  @@map("sale_mandate")
}

model BillingCustomer {
  userId                String    @id @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId      String    @unique @map("stripe_customer_id")
  plan                  BuyerPlan @default(none)
  stripeSubscriptionId  String?   @unique @map("stripe_subscription_id")
  periodStart           DateTime? @map("period_start")
  periodEnd             DateTime? @map("period_end")
  advisorInbox          Boolean   @default(false) @map("advisor_inbox")
  advisorSubscriptionId String?   @unique @map("advisor_subscription_id")

  @@map("billing_customer")
}

model ListingPayment {
  id                      String   @id
  userId                  String   @map("user_id")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId               String   @unique @map("project_id")
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stripeCheckoutSessionId String   @unique @map("stripe_checkout_session_id")
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("listing_payment")
}

enum EngagementClient {
  investor
  seller

  @@map("engagement_client")
}

enum EngagementAuthor {
  client
  advisor

  @@map("engagement_author")
}

model AdvisoryEngagement {
  id                   String              @id
  projectId            String              @map("project_id")
  project              Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requesterId          String              @map("requester_id")
  requester            User                @relation("EngagementRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  client               EngagementClient
  services             String[]
  advisorId            String?             @map("advisor_id")
  advisor              User?               @relation("EngagementAdvisor", fields: [advisorId], references: [id], onDelete: SetNull)
  claimedAt            DateTime?           @map("claimed_at")
  depositCents         Int                 @default(0) @map("deposit_cents")
  depositPaidAt        DateTime?           @map("deposit_paid_at")
  depositSessionId     String?             @unique @map("deposit_session_id")
  declinedAt           DateTime?           @map("declined_at")
  advisorNdaAcceptedAt DateTime?           @map("advisor_nda_accepted_at")
  advisorNdaSignature  Bytes?              @map("advisor_nda_signature")
  /// t93: exact adviser NDA text signed; the PDF is rendered from it.
  advisorNdaText       String?             @map("advisor_nda_text")
  closedAt             DateTime?           @map("closed_at")
  chargedCents         Int?                @map("charged_cents")
  platformNetCents     Int?                @map("platform_net_cents")
  platformVatCents     Int?                @map("platform_vat_cents")
  processOpened        Boolean             @default(false) @map("process_opened")
  createdAt            DateTime            @default(now()) @map("created_at")
  folders              AdvisorFolderOpen[]
  fileShares           AdvisorFileShare[]
  messages             EngagementMessage[]

  @@index([projectId])
  @@index([advisorId])
  @@index([requesterId])
  @@map("advisory_engagement")
}

model AdvisorFolderOpen {
  id           String             @id
  engagementId String             @map("engagement_id")
  engagement   AdvisoryEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  folder       String
  createdAt    DateTime           @default(now()) @map("created_at")

  @@unique([engagementId, folder])
  @@index([engagementId])
  @@map("advisor_folder_open")
}

model AdvisorFileShare {
  id           String             @id
  engagementId String             @map("engagement_id")
  engagement   AdvisoryEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  fileId       String             @map("file_id")
  file         DataRoomFile       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now()) @map("created_at")

  @@unique([engagementId, fileId])
  @@index([engagementId])
  @@index([fileId])
  @@map("advisor_file_share")
}

model EngagementMessage {
  id           String             @id
  engagementId String             @map("engagement_id")
  engagement   AdvisoryEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  author       EngagementAuthor
  kind         MessageKind
  body         String             @db.Text
  createdAt    DateTime           @default(now()) @map("created_at")

  @@index([engagementId, createdAt])
  @@map("engagement_message")
}

model WaitlistEntry {
  id        String       @id
  role      WaitlistRole
  name      String
  email     String
  city      String       @default("")
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([email, role])
  @@map("waitlist_entry")
}

model SuccessFee {
  id               String   @id
  projectId        String   @unique @map("project_id")
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  closedPriceCents Int      @map("closed_price_cents")
  buyerNetCents    Int      @map("buyer_net_cents")
  buyerVatCents    Int      @map("buyer_vat_cents")
  sellerNetCents   Int      @map("seller_net_cents")
  sellerVatCents   Int      @map("seller_vat_cents")
  recordedAt       DateTime @default(now()) @map("recorded_at")

  @@map("success_fee")
}

// PDF of a signed agreement, rendered once at signing time and served for download.
// key = "<kind>:<ref id>" (nda:<accessId>, loi:<accessId>, advisor_nda:<engagementId>, terms:<userId>).
model SignedDocument {
  id        String   @id @default(uuid())
  key       String   @unique
  kind      String
  userId    String   @map("user_id")
  fileName  String   @map("file_name")
  pdf       Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("signed_document")
}

// Sale contract (compraventa) for one buyer process. The seller or their advisor
// uploads versions; the buyer accepts or asks for changes; both sign in-platform.
// status: review | changes | accepted | signed | superseded
model SaleContract {
  id              String        @id
  accessId        String        @map("access_id")
  access          ProjectAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)
  version         Int
  fileName        String        @map("file_name")
  pdf             Bytes
  priceCents      Int           @map("price_cents")
  uploadedById    String        @map("uploaded_by_id")
  uploadedByRole  String        @map("uploaded_by_role")
  status          String        @default("review")
  reviewComment   String?       @map("review_comment")
  reviewedAt      DateTime?     @map("reviewed_at")
  buyerSignature  Bytes?        @map("buyer_signature")
  buyerSignedAt   DateTime?     @map("buyer_signed_at")
  sellerSignature Bytes?        @map("seller_signature")
  sellerSignedAt  DateTime?     @map("seller_signed_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([accessId, version])
  @@map("sale_contract")
}

/// When each admin last opened an admin page; rows newer than this show as NEW (sidebar bubble + highlight).
model AdminSeen {
  adminId String   @map("admin_id")
  page    String
  seenAt  DateTime @map("seen_at")

  @@id([adminId, page])
  @@map("admin_seen")
}

model ContactMessage {
  id        String   @id
  name      String
  email     String
  topic     String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_message")
}

model NewsletterSubscriber {
  email     String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscriber")
}

model FinancialFiling {
  id           String    @id
  projectId    String    @map("project_id")
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  year         Int
  kind         String
  fileName     String    @map("file_name")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  bytes        Bytes
  status       String    @default("uploaded")
  errorCode    String?   @map("error_code")
  extracted    Json?
  uploadedById String    @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  confirmedAt  DateTime? @map("confirmed_at")

  @@unique([projectId, year])
  @@index([projectId])
  @@map("financial_filing")
}

/// t67: a SABI import running in the background (after the confirm response), polled by the admin UI.
model SabiImportJob {
  id         String    @id
  projectId  String    @map("project_id")
  userId     String    @map("user_id")
  fileName   String    @map("file_name")
  /// running | done | failed
  status     String    @default("running")
  /// Last section reached (read, general, balance, results, ratios, directors, shareholders, saving).
  stage      String    @default("queued")
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  finishedAt DateTime? @map("finished_at")

  @@index([userId, createdAt])
  @@map("sabi_import_job")
}

/// t73b: fixed-window counters for anything that sends email (password reset, verification resend,
/// message notices). Key examples: "reset:ip:1.2.3.4", "reset:email:<sha256>", "msg:<access>:seller".
model EmailThrottle {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now()) @map("window_start")

  @@map("email_throttle")
}

/// Supporting file for one EBITDA adjustment. Bytes live in Neon: Workers have no persistent disk.
model AdjustmentDocument {
  id        String   @id
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName  String   @map("file_name")
  bytes     Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("adjustment_document")
}

/// t84: seller photo gallery for the ficha pública. Stored in Neon (Workers have no persistent disk). Admin can hide.
model ProjectPhoto {
  id        String   @id
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mime      String
  bytes     Bytes
  position  Int      @default(0)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("project_photo")
}
